# One-line train: 4-step student relayed from the 8-step lr_original 0002500 checkpoint.
# Remote script validates the previous-stage checkpoint and student_sample_steps=8 before launch,
# and derives NPROC_PER_NODE from CUDA_VISIBLE_DEVICES.
#
# Usage:
#   bash experiments/bin/run_remote_script.sh --dry-run experiments/configs/wan21_dmd2_step4_relay_train.env
#   bash experiments/bin/run_remote_script.sh           experiments/configs/wan21_dmd2_step4_relay_train.env
#
# For P1a/P1c variants: LR / batch / gan_r1_reg_weight live in the python config file on the remote.
# Copy fastgen/configs/experiments/WanT2V/config_dmd2_step4_from_step8_2p5k.py to a variant file
# (one variable changed, new log_config.name), then point CONFIG at it via REMOTE_ENV below.
REMOTE_SCRIPT=fastgen/configs/experiments/WanT2V/run_train_dmd2_step4_from_step8_2p5k.sh
RUN_NAME=wan21_dmd2_step4_relay_train
CUDA_DEVICES=0,1,2,3,4,5,6,7
GPU_MAX_USED_MB=100
REMOTE_ENV='CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7'
# Other overridable remote vars (append inside REMOTE_ENV):
#   PREV_EXP=... PREV_CKPT=...   change the relay init checkpoint prefix
#   CONFIG=fastgen/configs/experiments/WanT2V/<variant>.py
#   NPROC_PER_NODE=<n>
DETACH=1
