# One-line inference sweep: 4-from-8 relay checkpoints on the 10 OpenVid eval prompts.
# Skips checkpoints whose output folder is already complete (FORCE=1 to redo).
#
# Usage:
#   bash experiments/bin/run_remote_script.sh --dry-run experiments/configs/wan21_dmd2_step4_relay_eval10.env
#   bash experiments/bin/run_remote_script.sh           experiments/configs/wan21_dmd2_step4_relay_eval10.env
REMOTE_SCRIPT=fastgen/configs/experiments/WanT2V/run_infer_dmd2_step4_from_step8_8node_eval10.sh
RUN_NAME=wan21_dmd2_step4_relay_eval10
CUDA_DEVICES=0
GPU_MAX_USED_MB=100
REMOTE_ENV='CUDA_VISIBLE_DEVICES=0 CKPTS="0000500 0001000 0001500 0002000 0002500" FORCE=0'
# Other overridable remote vars (append inside REMOTE_ENV):
#   EXP_ROOT=FASTGEN_OUTPUT/fastgen/wan_dmd2/<run_dir>   evaluate a different run
#   CONFIG=fastgen/configs/experiments/WanT2V/<config>.py
#   SEED=<n> FPS=<n>
DETACH=1
