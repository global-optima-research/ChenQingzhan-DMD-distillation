# One-line driver for the remote three-zone sprint workspace (FastGen/exp/).
# Switch experiments by changing ONLY the CONF value below (or copy this env per experiment):
#   train:  CONF=exp/confs/E1a.conf | E1b.conf | E2a.conf | E2b.conf | E2c.conf
#   eval:   set REMOTE_SCRIPT=exp/eval_sweep.sh and CONF=exp/confs/EVAL_e1a.conf
# exp/run.sh does its own GPU precheck and backgrounds the training itself,
# so this wrapper runs foreground (DETACH=0) to capture the pid + log path echo.
REMOTE_SCRIPT=exp/run.sh
RUN_NAME=wan21_sprint_launch
REMOTE_ENV='CONF=exp/confs/E1b.conf'
DETACH=0
